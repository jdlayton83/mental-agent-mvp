{
  "name": "mental-agent-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs=require('fs');if(fs.existsSync('.next'))fs.rmSync('.next',{recursive:true,force:true,maxRetries:10,retryDelay:100})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.test.json && node .test-dist/tests/run.js",
    "secrets:check": "git ls-files | node scripts/check-secrets.mjs",
    "env:check": "git ls-files src | node scripts/check-env-access.mjs",
    "ai:check": "git ls-files src | node scripts/check-ai-provider-boundary.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "privacy:check": "node scripts/check-privacy-export.mjs",
    "presentation:check": "git ls-files src/app src/components | node scripts/check-presentation-db-boundary.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run secrets:check && npm run env:check && npm run ai:check && npm run db:check && npm run privacy:check && npm run presentation:check && npm run format:check && npm run build -- --webpack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "node scripts/drizzle-generate-disabled.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
