{
  "name": "mental-agent-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/next-dev-no-fork.mjs",
    "prebuild": "node -e \"const fs=require('fs');if(fs.existsSync('.next'))fs.rmSync('.next',{recursive:true,force:true,maxRetries:10,retryDelay:100})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "secrets:check": "git ls-files | node scripts/check-secrets.mjs",
    "env:check": "git ls-files src | node scripts/check-env-access.mjs",
    "env-example:check": "node scripts/check-env-example.mjs",
    "seed-runner:check": "node scripts/check-seed-runner.mjs",
    "ai:check": "git ls-files src | node scripts/check-ai-provider-boundary.mjs",
    "ai-rate-limit:check": "git ls-files src | node scripts/check-ai-rate-limit.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "schema:check": "node scripts/check-schema-index.mjs",
    "privacy:check": "node scripts/check-privacy-export.mjs",
    "presentation:check": "git ls-files src/app src/components | node scripts/check-presentation-db-boundary.mjs",
    "routes:check": "node scripts/check-routes.mjs",
    "auth-routes:check": "node scripts/check-auth-routes.mjs",
    "consent-routes:check": "node scripts/check-consent-routes.mjs",
    "server-actions:check": "git ls-files src | node scripts/check-server-actions.mjs",
    "security-headers:check": "node scripts/check-security-headers.mjs",
    "quality:check": "npm run typecheck && npm run lint && npm run test && npm run secrets:check && npm run env:check && npm run env-example:check && npm run seed-runner:check && npm run ai:check && npm run ai-rate-limit:check && npm run db:check && npm run schema:check && npm run privacy:check && npm run presentation:check && npm run routes:check && npm run auth-routes:check && npm run consent-routes:check && npm run server-actions:check && npm run security-headers:check && npm run format:check",
    "ci": "npm run quality:check && npm run build -- --webpack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "node scripts/drizzle-generate-disabled.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types --import ./scripts/register-ts-seed-loader.mjs src/db/seed.ts",
    "pilot:check": "node --env-file=.env scripts/check-local-pilot-state.mjs",
    "smoke:local": "node --env-file=.env scripts/check-local-smoke.mjs",
    "ready:local": "npm run pilot:check && npm run smoke:local && npm run quality:check"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
